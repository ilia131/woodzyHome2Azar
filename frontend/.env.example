# Leave empty for the independent showcase catalog.
DJANGO_API_URL=
STORE_CURRENCY=IRR

# Slug for the featured living-room category when the backend uses a different slug.
LIVING_CATEGORY_SLUG=

# Optional public path, for example /brand/woodzyhome.png
WOODZY_LOGO_PATH=

# Enable only against an isolated payment test backend.
WOODZY_TEST_PAYMENTS=0
# Optional local next dev catalog when no API base is configured.
WOODZY_SHOWCASE=0
# Optional browser-reachable media base, e.g. https://api.example.com/media
DJANGO_MEDIA_URL=
